# Server configuration
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
SECRET_KEY=cogniagent-super-secret-key-change-in-production-1234567890

# Google Apps Script Web App Email Gateway (Primary - Zero-Cost, No Custom Domain Required)
# Deploy your Google Apps Script at script.google.com as a Web App (Access: Anyone)
GMAIL_GATEWAY_URL=https://script.google.com/macros/s/your_deployment_id/exec
GMAIL_GATEWAY_SECRET=your_custom_secret_key_matching_apps_script
MAX_DAILY_EMAILS=90

# Secondary Fallback: Resend Transactional HTTPS API (Requires verified custom domain for arbitrary recipients)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=CogniAgent <noreply@yourdomain.com>

# Optional Local SMTP Configuration (Disabled by default; enable only for local offline debugging)
# In cloud hosting (Render, AWS, DigitalOcean), outbound SMTP ports 25, 465, 587 are blocked by default.
ENABLE_LOCAL_SMTP_DEBUG=false
SENDER_EMAIL=your_email@gmail.com
SENDER_APP_PASSWORD=your_16_digit_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Database (defaults to sqlite database file in backend directory)
DATABASE_PATH=auth.db
