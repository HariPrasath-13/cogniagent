{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/register",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/verify-registration",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/login",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/send-login-otp",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/verify-login-otp",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/resend-otp",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/me",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
